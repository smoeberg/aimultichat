DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="multichat"
DB_USER="multichat"
DB_PASSWORD="replace-me"
ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ENV=production
SESSION_SECURE=true
SESSION_MAX_AGE=28800
TRUST_PROXY_HEADERS=false
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_IP_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=300
MAX_MESSAGE_CHARS=20000
MAX_RESPONSE_CHARS=50000
MAX_HISTORY_MESSAGES=40
MAX_HISTORY_CHARS=100000
CHAT_RETENTION_DAYS=0
PROVIDER_ALLOWED_HOSTS=
PROVIDER_ALLOWED_PORTS=443
PROVIDER_ALLOW_PRIVATE_NETWORKS=false
PROVIDER_CONNECT_TIMEOUT=10
PROVIDER_TIMEOUT=45
PROVIDER_MAX_RESPONSE_BYTES=1048576
GITHUB_CONTEXT_MAX_FILES=10
GITHUB_CONTEXT_FILE_BYTES=3000
GITHUB_CONTEXT_MAX_BYTES=40000
GITHUB_API_MAX_RESPONSE_BYTES=10485760
LOG_PATH="/absolute/path/to/multichat/storage/logs/app.log"
