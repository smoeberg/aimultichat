{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMultiChat",
  "version": "1.0.0",
  "identifier": "dk.moeberg.aimultichat.winapp",
  "build": {
    "devUrl": "http://localhost:8000",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "AI MultiChat Desktop",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}